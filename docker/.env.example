# Copy this file to ".env" and fill in real values.
# Do not commit the .env file to Git (add it to .gitignore).

# --- Host-Ports ---
BACKEND_PORT=8000
FRONTEND_PORT=80


# --- Backend Secrets ---
SESSION_SECRET=change_me
ENCRYPTION_SECRET=change_me
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_FINE_GRAINED_TOKEN=your_github_finegrained_token

# --- Polarion ---
# Path (inside the container) to the Polarion server's CA certificate.
POLARION_CA_CERT_PATH=/polarion-ca.pem
